+ }return pixels;
+}
+const palette=['','#bdced1','#dce9e7','#f1f7f3'],worlds=new WeakMap();let activeOwner=null;
+const release=entry=>{if(entry?.canvas)entry.canvas.width=entry.canvas.height=0};
+function store(world){let s=worlds.get(world);if(!s){s={entries:new Map(),capacity:1024,builds:0};worlds.set(world,s)}return s}
+// The native texture working set is bounded by the actual visible local window.
+// Keep one active World's artwork, without retaining that World through a strong owner.
+export function beginSnowWindow(world,capacity){const previous=activeOwner?.deref();if(previous!==world){if(previous){const old=worlds.get(previous);if(old)for(const entry of old.entries.values())release(entry);worlds.delete(previous)}activeOwner=new WeakRef(world)}const s=store(world);s.capacity=Math.max(0,Math.min(world.n*world.n,Math.ceil(Number.isFinite(capacity)?capacity:0)));while(s.entries.size>s.capacity){const key=s.entries.keys().next().value;release(s.entries.get(key));s.entries.delete(key)}}
+// Read-only diagnostics for developer review tools; no World or texture references escape.
+export function snowGroundArtStats(world){const s=worlds.get(world);return s?{entries:s.entries.size,capacity:s.capacity,builds:s.builds}:{entries:0,capacity:0,builds:0}}
+function cached(world,x,y,cover,waterMask){const state=store(world),entries=state.entries,key=y*world.n+x;let entry=entries.get(key);if(entry&&entry.cover===cover&&entry.waterMask===waterMask){entries.delete(key);entries.set(key,entry);return entry}state.builds++;
+ const pixels=snowGroundPixels({seed:world.seedHash,x,y,originX:world.regionOrigin?.x||0,originY:world.regionOrigin?.y||0,cover,waterMask}),canvas=entry?.canvas||(typeof document!=='undefined'?document.createElement('canvas'):null);if(canvas){canvas.width=canvas.height=32;const ctx=canvas.getContext('2d');if(ctx){const data=ctx.createImageData(32,32),rgb=[[0,0,0],[189,206,209],[220,233,231],[241,247,243]];for(let i=0;i<1024;i++){const p=pixels[i];if(p){const q=i*4;data.data[q]=rgb[p][0];data.data[q+1]=rgb[p][1];data.data[q+2]=rgb[p][2];data.data[q+3]=255}}ctx.putImageData(data,0,0)}}entry={cover,waterMask,pixels,canvas};if(!entries.has(key)&&entries.size>=state.capacity){const old=entries.keys().next().value;release(entries.get(old));entries.delete(old)}entries.set(key,entry);return entry;
+}
+export function drawSnowGround(ctx,{world,x,y,px,py,tile,waterMask}){
+ const i=world.idx(x,y);if(world.water[i]||!(world.soilWater?.snowpack?.[i]>=.012))return false;const cover=snowCover(world,i),entry=cached(world,x,y,cover,waterMask);
+ ctx.save();try{ctx.globalAlpha*=Math.min(.91,.22+cover*.72);if(entry.canvas&&typeof ctx.drawImage==='function'){ctx.imageSmoothingEnabled=false;ctx.drawImage(entry.canvas,px,py,tile,tile)}else{for(let y=0;y<32;y++){let x=0;while(x<32){const p=entry.pixels[y*32+x],start=x++;while(x<32&&entry.pixels[y*32+x]===p)x++;if(p){ctx.fillStyle=palette[p];ctx.fillRect(px+start*tile/32,py+y*tile/32,(x-start)*tile/32,tile/32)}}}}}finally{ctx.restore()}return true;
+}
